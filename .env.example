# Local Docker services
MYSQL_DATABASE=hust_chatbox
MYSQL_USER=hust_chatbox
MYSQL_PASSWORD=replace-with-a-local-password
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password
MYSQL_PORT=3306
REDIS_PORT=6379

# Backend (copy this file to backend/.env for local development)
DATABASE_URL=mysql+aiomysql://hust_chatbox:replace-with-a-local-password@127.0.0.1:3306/hust_chatbox
REDIS_URL=redis://127.0.0.1:6379/0
OTP_SECRET=replace-with-a-random-secret
JWT_SECRET=replace-with-a-random-secret
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
EMAIL_FROM=noreply@hust.edu.vn
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
MATCH_THRESHOLD=0.5
