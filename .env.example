# ==============================================================================
# HUST CHATBOX - ROOT ENVIRONMENT CONFIGURATION EXAMPLE (.env.example)
# Copy to `.env` in the repository root. Used by Docker Compose only.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DOCKER COMPOSE LOCAL SERVICES (MySQL, Redis, Mailpit)
# ------------------------------------------------------------------------------
MYSQL_DATABASE=hust_chatbox
MYSQL_USER=hust_chatbox
MYSQL_PASSWORD=replace-with-a-local-password
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password
MYSQL_PORT=3306
REDIS_PORT=6379
