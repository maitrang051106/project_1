# ==============================================================================
# HUST CHATBOX - BACKEND CONFIGURATION (.env.example)
# Copy this file to `backend/.env` for local development.
# ==============================================================================

APP_NAME="HUST Chatbox API"
ENVIRONMENT=development

# Database connection URL (MySQL with async aiomysql driver)
# Local: mysql+aiomysql://hust_chatbox:<password>@127.0.0.1:3306/hust_chatbox
# Aiven: mysql+aiomysql://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL=mysql+aiomysql://hust_chatbox:replace-with-a-local-password@127.0.0.1:3306/hust_chatbox

# Redis connection URL
# Local: redis://127.0.0.1:6379/0
REDIS_URL=redis://127.0.0.1:6379/0

# Security Secrets (Generate secure random 32+ byte strings for production)
OTP_SECRET=replace-with-a-random-32b-secret-key-for-otp
EMAIL_HASH_SECRET=replace-with-a-random-32b-secret-key-for-email-hash
JWT_SECRET=replace-with-a-random-32b-secret-key-for-jwt
JWT_ALGORITHM=HS256
JWT_EXPIRE_SECONDS=86400

# Authentication rate limits
RATE_LIMIT_IP_REQUESTS=20
RATE_LIMIT_IP_WINDOW_SECONDS=60
RATE_LIMIT_EMAIL_REQUESTS=5
RATE_LIMIT_EMAIL_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_EMAIL_ATTEMPTS=10
LOGIN_RATE_LIMIT_EMAIL_WINDOW_SECONDS=900

# Local email capture via Mailpit (Docker Compose, web UI at localhost:8025)
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=hustchatbox@gmail.com
EMAIL_USE_TLS=false

# For a real SMTP provider, replace the values above and enable TLS as required.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USERNAME=your-email@gmail.com
# EMAIL_PASSWORD=your-gmail-app-password
# EMAIL_FROM=your-email@gmail.com
# EMAIL_USE_TLS=true

# CORS & Cookie Security
# Local dev: http://localhost:5173, COOKIE_SECURE=false, COOKIE_SAMESITE=lax
# Production: https://your-domain.vercel.app, COOKIE_SECURE=true, COOKIE_SAMESITE=none
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
