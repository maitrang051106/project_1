# ==============================================================================
# HUST CHATBOX - FRONTEND CONFIGURATION (.env.example)
# Copy this file to `frontend/.env` for local development.
# ==============================================================================

# REST API Base URL
# - Local dev: /api (handled via Vite dev server reverse proxy)
# - Production (Vercel): https://your-backend-api.onrender.com
VITE_API_URL=/api

# Local Vite Dev Proxy Target (Only used during local `npm run dev`)
VITE_DEV_API_TARGET=http://127.0.0.1:8000

# WebSocket Base URL for anonymous & direct chat rooms
# - Local dev: ws://127.0.0.1:8000
# - Production: wss://your-backend-api.onrender.com
VITE_WS_URL=ws://127.0.0.1:8000
